# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/career_engine

# ATS ingestion operational limits
ATS_HTTP_TIMEOUT_SECONDS=10
ATS_MAX_RESPONSE_MB=50
ATS_MAX_ATTEMPTS=3
ATS_GLOBAL_CONCURRENCY=12
ATS_HTTP_MAX_CONNECTIONS=20
ATS_HTTP_MAX_KEEPALIVE_CONNECTIONS=10

# Auth
SECRET_KEY=change-this-to-a-random-secret-key
ACCESS_TOKEN_EXPIRE_MINUTES=60

# CORS — comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:3000

# Google OAuth — "Continue with Google" (OAuth 2.0 Web client ID from
# https://console.cloud.google.com/apis/credentials). Leave blank to disable.
GOOGLE_CLIENT_ID=

# Onboarding uploads
MAX_UPLOAD_MB=5
MAX_RESUMES_PER_USER=2

# AI — set at least one key. Provider priority: Groq → Gemini → OpenAI
# Groq: free tier, fast, llama-3.3-70b-versatile — https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Gemini: free tier via https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# OpenAI fallback
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
