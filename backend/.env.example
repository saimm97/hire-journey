# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/career_engine

# Auth
SECRET_KEY=change-this-to-a-random-secret-key
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Google OAuth — "Continue with Google" (OAuth 2.0 Web client ID from
# https://console.cloud.google.com/apis/credentials). Leave blank to disable.
GOOGLE_CLIENT_ID=

# AI (Gemini is the primary provider)
GEMINI_API_KEY=your-gemini-api-key

# Optional: OpenAI fallback
OPENAI_API_KEY=
